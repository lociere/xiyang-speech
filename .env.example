# Resource paths are relative to the repository unless absolute.
XIYANG_ASR_MODEL_DIR=models/asr/Fun-ASR-Nano-2512
XIYANG_TTS_MODEL_DIR=models/tts/Fun-CosyVoice3-0.5B-2512
XIYANG_WETEXT_MODEL_DIR=models/tts/wetext
XIYANG_TTS_SOURCE_DIR=third_party/CosyVoice
XIYANG_TALK_SOURCE_DIR=third_party/MuseTalk
XIYANG_REFERENCE_AUDIO=data/xiyang_prompt.wav
XIYANG_OUTPUT_DIR=runtime/outputs
XIYANG_UPLOAD_DIR=runtime/uploads
XIYANG_TTS_INSTRUCTION="You are a helpful assistant. 请用山西话表达。<|endofprompt|>"

# Application listener; use 0.0.0.0 for LAN access.
XIYANG_HOST=127.0.0.1
XIYANG_PORT=8000
# Model workers must use loopback addresses.
XIYANG_ASR_WORKER_URL=http://127.0.0.1:8101
XIYANG_TTS_WORKER_URL=http://127.0.0.1:8102
XIYANG_TALK_WORKER_URL=http://127.0.0.1:8103
XIYANG_ASR_DEVICE=cuda:0

# Optional interpreter overrides; defaults use sibling Conda environments.
# XIYANG_ASR_PYTHON=/opt/miniforge3/envs/xiyang-asr/bin/python
# XIYANG_TTS_PYTHON=/opt/miniforge3/envs/xiyang-tts/bin/python
# XIYANG_TALK_PYTHON=/opt/miniforge3/envs/MuseTalk/bin/python

# Scheduler limits. Timeouts are in seconds; file limits are in MB.
XIYANG_MODEL_IDLE_SECONDS=120
XIYANG_MODEL_START_TIMEOUT=300
XIYANG_INFERENCE_TIMEOUT=300
# Video synthesis has a separate per-request budget.
XIYANG_TALK_INFERENCE_TIMEOUT=1800
XIYANG_MAX_QUEUED_JOBS=8
XIYANG_MAX_AUDIO_SECONDS=60
XIYANG_MAX_AUDIO_MB=25
XIYANG_MAX_IMAGE_MB=8
